# ================================================================
#  CONTAFÁCIL SQ — Frontend Environment Variables
#  Copy to .env.local and fill in real values.
#  NEVER commit .env.local to version control.
# ================================================================

# Public API URL — must be reachable from the browser
# Development:  http://localhost:3001
# Production:   https://api.yourdomain.cr
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── SEO / dominio público ───────────────────────────────────────
# URL canónica ABSOLUTA del sitio (sin barra final). Se usa para metadataBase,
# canonical, OpenGraph, sitemap.xml y robots.txt.
# ¡IMPORTANTE! Fijala al dominio REAL de producción o Google indexará URLs
# incorrectas. El fallback del código es https://contasj.cr (solo de reserva).
# Development:  http://localhost:3000
# Production:   https://tudominio.cr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase Auth ───────────────────────────────────────────────
# URL del proyecto Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key — segura para el navegador (Settings → API → Project API keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
