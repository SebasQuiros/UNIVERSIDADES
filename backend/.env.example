# ================================================================
#  CONTAFÁCIL SQ — Backend Environment Variables
#  Copy to .env and fill in real values before running.
#  NEVER commit .env to version control.
# ================================================================

# ── Database ───────────────────────────────────────────────────
POSTGRES_DB=contafacil
POSTGRES_USER=contafacil
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_PORT=5432

# Conexión de Prisma a Supabase Postgres.
# DATABASE_URL = pooler en modo transaction (Supavisor, puerto 6543) para el
#   runtime; requiere el sufijo ?pgbouncer=true porque el pooler no soporta
#   prepared statements.
DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT_URL = pooler en modo session (puerto 5432); lo usan las migraciones y
#   el seed (necesitan conexión directa sin pgbouncer).
DIRECT_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-region.pooler.supabase.com:5432/postgres

# ── Supabase Auth ──────────────────────────────────────────────
# URL base del proyecto Supabase (sin barra final)
SUPABASE_URL=https://PROJECT_REF.supabase.co
# JWKS del emisor: el backend valida el JWT de Supabase contra estas claves
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Service role key (SECRETO — solo backend): crea/administra usuarios en Supabase Auth.
# NUNCA la expongas en el frontend.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_service_role_key

# ── Server ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production          # development | production
CORS_ORIGIN=https://yourdomain.cr   # comma-separated for multiple origins
FRONTEND_URL=https://yourdomain.cr

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379
# Leave blank for dev without auth:
# REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Email / SMTP ───────────────────────────────────────────────
# Gmail example — use an App Password (not your account password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.cr
SMTP_PASS=CHANGE_ME_app_password
SMTP_FROM=CONTAFÁCIL SQ <noreply@yourdomain.cr>

# ── AI assistant ────────────────────────────────────────────────
# Leave blank to disable the AI assistant
ANTHROPIC_API_KEY=

# ── File storage ────────────────────────────────────────────────
# Local paths — replace with S3/MinIO URLs in production
UPLOADS_PATH=./uploads
PDF_PATH=./uploads/pdfs
XML_PATH=./uploads/xmls
# TODO(production): Configure object storage instead of local disk:
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
