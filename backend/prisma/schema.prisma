  identification String
  idType         String   @default("01") @map("id_type")
  // 01 física, 02 jurídica, 03 DIMEX, 04 NITE
  email          String?
  phone          String?
  address        String?
  creditDays     Int      @default(0) @map("credit_days")
  creditLimit    Decimal  @default(0) @map("credit_limit") @db.Decimal(15,2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  payments Payment[]
  accountsReceivable AccountReceivable[]
  quotes   Quote[]

  @@index([companyId])
  @@map("clients")
}

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  name           String
  identification String?
  idType         String?  @map("id_type")
  email          String?
  phone          String?
  address        String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
