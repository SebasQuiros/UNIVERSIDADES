model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  clientId     String        @map("client_id")  @db.Uuid
  amount       Decimal       @db.Decimal(15,2)
  currency     String        @default("CRC")
