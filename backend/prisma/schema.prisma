// ================================================================
//  BANK RECONCILIATION
// ================================================================

model BankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  name          String                          // "Cuenta BAC #001"
  bankName      String   @map("bank_name")     // "BAC", "BCR", "BN"
  accountNumber String?  @map("account_number")
  currency      String   @default("CRC")
  currentBalance Decimal @default(0) @db.Decimal(15,2) @map("current_balance")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  statements    BankStatement[]
  transactions  BankTransaction[]

  @@index([companyId])
  @@map("bank_accounts")
}

model BankStatement {
  id             String   @id @default(uuid()) @db.Uuid
  bankAccountId  String   @map("bank_account_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  fileName       String   @map("file_name")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  totalCredits   Decimal  @db.Decimal(15,2) @map("total_credits")
  totalDebits    Decimal  @db.Decimal(15,2) @map("total_debits")
  closingBalance Decimal  @db.Decimal(15,2) @map("closing_balance")
  status         String   @default("PENDING")  // PENDING, IN_PROGRESS, COMPLETED
  reconciledAt   DateTime? @map("reconciled_at")
  createdAt      DateTime @default(now()) @map("created_at")

  bankAccount    BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines          BankStatementLine[]

  @@index([companyId])
  @@index([bankAccountId])
  @@map("bank_statements")
}

model BankStatementLine {
  id              String   @id @default(uuid()) @db.Uuid
  statementId     String   @map("statement_id") @db.Uuid
  date            DateTime
  description     String
  reference       String?
  debit           Decimal  @default(0) @db.Decimal(15,2)
  credit          Decimal  @default(0) @db.Decimal(15,2)
  balance         Decimal? @db.Decimal(15,2)
  status          String   @default("UNMATCHED")  // UNMATCHED, MATCHED, IGNORED
  matchedTxId     String?  @map("matched_tx_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  statement       BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@map("bank_statement_lines")
}

model BankTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  bankAccountId  String?  @map("bank_account_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  date           DateTime
  description    String
  reference      String?
  amount         Decimal  @db.Decimal(15,2)
  type           String   // DEBIT, CREDIT
  source         String   @default("MANUAL") // INVOICE, PURCHASE, PAYROLL, MANUAL
  sourceId       String?  @map("source_id") @db.Uuid
  isReconciled   Boolean  @default(false) @map("is_reconciled")
  reconciledAt   DateTime? @map("reconciled_at")
  statementLineId String? @map("statement_line_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([bankAccountId])
  @@map("bank_transactions")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id")    @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  action     String
  entity     String?
  entityId   String?  @map("entity_id") @db.Uuid
  ipAddress  String?  @map("ip_address")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([createdAt(sort: Desc)])
  @@map("activity_log")
}

// ================================================================
//  BLOQUE 11 — ACTIVOS FIJOS
// ================================================================

enum DepreciationMethod {
  STRAIGHT_LINE
  SUM_OF_DIGITS
  DOUBLE_DECLINING
}

model FixedAsset {
  id                  String             @id @default(uuid()) @db.Uuid
  companyId           String             @map("company_id") @db.Uuid
  name                String
  description         String?
  acquisitionDate     DateTime           @map("acquisition_date") @db.Date
  acquisitionCost     Decimal            @map("acquisition_cost") @db.Decimal(15,2)
