  purchaseInvoiceId String   @unique @map("purchase_invoice_id") @db.Uuid
  total             Decimal  @db.Decimal(15, 2)
  balance           Decimal  @db.Decimal(15, 2)
  status            APStatus @default(PENDING)
  dueDate           DateTime? @map("due_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  company         Company         @relation(fields: [companyId],         references: [id], onDelete: Cascade)
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([supplierName])
  @@map("accounts_payable")
}

// ================================================================
//  BLOQUE 17 — SESIÓN DE AULA (Fase 2b)
// ================================================================
//
// Simulación de aula en vivo (estilo Kahoot) sobre un Exercise en
// modo GROUP: el profesor abre una sesión con código de unión, los
// estudiantes se agrupan en empresas (arquetipos), operan, tributan,
// y se auditan entre sí (derangement auditor↔auditado). El snapshot
// de EEFF/declaraciones queda congelado en columnas propias
// (ClassSessionCompany.snapshot*) para que el guard de auditoría
// nunca necesite leer tablas operativas de la empresa auditada.

enum ClassSessionStatus {
  DRAFT
  LOBBY
  EN_CURSO
  TRIBUTACION
  AUDITORIA
  CALIFICACION
  FINALIZADA
  CANCELADA
}

enum ClassSessionArchetype {
  FERRETERIA
  AGENCIA_PUBLICIDAD
  BUFETE_CONTABLE
  DISTRIBUIDOR
}

model ClassSession {
  id            String             @id @default(uuid()) @db.Uuid
  exerciseId    String             @unique @map("exercise_id") @db.Uuid   // 1:1 con Exercise
  teacherId     String             @map("teacher_id") @db.Uuid            // denormalizado (mismo criterio que Exercise.teacherId)
  code          String             @unique @db.VarChar(6)                 // código de unión proyectable
  status        ClassSessionStatus @default(DRAFT)
  minGroupSize  Int                @default(3) @map("min_group_size")
  maxGroupSize  Int                @default(6) @map("max_group_size")
  settings      Json               @default("{}")                        // pesos del score, etc.
  startedAt     DateTime?          @map("started_at")
  closedOpsAt   DateTime?          @map("closed_ops_at")
  snapshotAt    DateTime?          @map("snapshot_at")
  auditClosedAt DateTime?          @map("audit_closed_at")
  finalizedAt   DateTime?          @map("finalized_at")
  cancelledAt   DateTime?          @map("cancelled_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt      @map("updated_at")

  exercise     Exercise                       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  teacher      User                           @relation("TeacherClassSessions", fields: [teacherId], references: [id])
  companies    ClassSessionCompany[]
  participants ClassSessionParticipant[]
  assignments  ClassSessionAuditAssignment[]

  @@index([teacherId])
  @@index([status])
  @@map("class_sessions")
}

// Un participante = un estudiante dentro de ESTA sesión. companyId queda
// NULL hasta que el profesor lo asigna a un grupo (o el auto-assign).
model ClassSessionParticipant {
  id             String   @id @default(uuid()) @db.Uuid
  classSessionId String   @map("class_session_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  companyId      String?  @map("company_id") @db.Uuid          // NULL hasta asignación a grupo
  joinedAt       DateTime @default(now()) @map("joined_at")
  lastPingAt     DateTime @default(now()) @map("last_ping_at")

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      User         @relation("StudentClassSessionParticipations", fields: [studentId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id])

  @@unique([classSessionId, studentId])   // idempotencia del join
  @@index([classSessionId])
  @@index([companyId])
  @@map("class_session_participants")
}

model ClassSessionCompany {
  id             String                @id @default(uuid()) @db.Uuid
  classSessionId String                @map("class_session_id") @db.Uuid
  companyId      String                @unique @map("company_id") @db.Uuid  // la Company GROUP ya existe
  archetype      ClassSessionArchetype

  // Snapshot inmutable — se llenan UNA vez en publish-snapshot, nunca se sobreescriben.
  snapshotTrialBalance    Json?     @map("snapshot_trial_balance")
  snapshotBalanceSheet    Json?     @map("snapshot_balance_sheet")
  snapshotIncomeStatement Json?     @map("snapshot_income_statement")
  snapshotTaxDeclarations Json?     @map("snapshot_tax_declarations")
  snapshotPublishedAt     DateTime? @map("snapshot_published_at")

  oracleDiscrepancies Json? @map("oracle_discrepancies")  // discrepancias reales calculadas por el oráculo

  accountingScore Decimal? @db.Decimal(5, 2) @map("accounting_score")
  auditScore      Decimal? @db.Decimal(5, 2) @map("audit_score")

  createdAt DateTime @default(now()) @map("created_at")

  classSession ClassSession                 @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  company      Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asAuditor    ClassSessionAuditAssignment? @relation("Auditor")
  asAuditee    ClassSessionAuditAssignment? @relation("Auditee")

  @@index([classSessionId])
  @@map("class_session_companies")
}

// Cada empresa audita EXACTAMENTE a otra, y es auditada por EXACTAMENTE otra
// (derangement aleatorio calculado al publicar el snapshot).
model ClassSessionAuditAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  classSessionId   String   @map("class_session_id") @db.Uuid
  auditorCompanyId String   @unique @map("auditor_company_id") @db.Uuid  // cada empresa audita a UNA
  auditeeCompanyId String   @unique @map("auditee_company_id") @db.Uuid  // y es auditada por UNA
  createdAt        DateTime @default(now()) @map("created_at")

  classSession ClassSession               @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  auditor      ClassSessionCompany        @relation("Auditor", fields: [auditorCompanyId], references: [companyId], onDelete: Cascade)
  auditee      ClassSessionCompany        @relation("Auditee", fields: [auditeeCompanyId], references: [companyId], onDelete: Cascade)
  findings     ClassSessionAuditFinding[]

  @@index([classSessionId])
  @@map("class_session_audit_assignments")
}

model ClassSessionAuditFinding {
  id            String   @id @default(uuid()) @db.Uuid
  assignmentId  String   @map("assignment_id") @db.Uuid
  createdById   String   @map("created_by") @db.Uuid   // miembro de la empresa auditora
  section       String                                 // 'BALANCE_SHEET'|'INCOME_STATEMENT'|'TAX_D101'|'TAX_D104'|'TAX_D103'|'TAX_D115'|'OTHER'
  accountCode   String?  @map("account_code")
  description   String   @db.Text
  claimedAmount Decimal? @db.Decimal(15, 2) @map("claimed_amount")
  createdAt     DateTime @default(now()) @map("created_at")

  matched     Boolean? // null = aún no evaluado por el oráculo
  matchDetail String?  @db.Text @map("match_detail")

  assignment ClassSessionAuditAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdBy  User                        @relation("UserClassSessionFindings", fields: [createdById], references: [id])

  @@index([assignmentId])
  @@map("class_session_audit_findings")
}

// ================================================================
//  BLOQUE 17 — NOTAS DE CRÉDITO Y DÉBITO (Phase 17)
//
//  Documentos que ajustan una factura electrónica ya emitida:
//    · Nota de Crédito (NC) → REVERSA parcial de una venta (devolución,
//      descuento, anulación). Reduce lo que el cliente debe (o devuelve
//      efectivo). Contablemente: D Ventas + D IVA débito ... C CxC/Caja.
//      Si hubo devolución de mercadería, además restaura inventario y
//      revierte el COGS.
//    · Nota de Débito (ND) → AUMENTA lo que el cliente debe (intereses,
//      cargos, ajuste al alza). Contablemente: D CxC ... C Ventas +
//      C IVA débito. Nunca toca inventario.
//
//  Ambas cuelgan de una Invoice origen (misma empresa) y disparan su
//  asiento vía BusinessEventsService (patrón event-driven canónico),
//  con idempotencia por (source_type, source_id) en journal_entries.
//  Consecutivo atómico por empresa (misma mecánica que invoice_sequences).
// ================================================================

enum CreditDebitNoteStatus {
  DRAFT
  ISSUED
}

model CreditNote {
  id          String                @id @default(uuid()) @db.Uuid
  companyId   String                @map("company_id") @db.Uuid
  // Factura origen (misma empresa). Requerida: una NC siempre corrige una FE.
  invoiceId   String                @map("invoice_id") @db.Uuid
  number      Int                                        // consecutivo por empresa
  issueDate   DateTime              @map("issue_date")
  reason      String?
  subtotal    Decimal               @default(0) @db.Decimal(15, 2)
  tax         Decimal               @default(0) @db.Decimal(15, 2)
  total       Decimal               @default(0) @db.Decimal(15, 2)
  status      CreditDebitNoteStatus @default(DRAFT)
  // Si true, la NC implica devolución de mercadería: restaura stock y
  // revierte COGS de las líneas con producto. Si false (descuento/ajuste),
  // NO toca inventario.
  restoreInventory Boolean          @default(false) @map("restore_inventory")
  createdById String                @map("created_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt      @map("updated_at")

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice          @relation(fields: [invoiceId], references: [id])
  lines   CreditNoteLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([invoiceId])
  @@index([status])
  @@map("credit_notes")
}

model CreditNoteLine {
  id           String   @id @default(uuid()) @db.Uuid
  creditNoteId String   @map("credit_note_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  lineNo       Int      @map("line_no")
  description  String
  quantity     Decimal  @db.Decimal(15, 3)
  unit         String   @default("Unid")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(15, 2)
  taxRate      Decimal  @map("tax_rate")   @db.Decimal(5, 2)
  taxAmount    Decimal  @map("tax_amount") @db.Decimal(15, 2)
  subtotal     Decimal  @db.Decimal(15, 2)
  total        Decimal  @db.Decimal(15, 2)
  cabysCode    String?  @map("cabys_code")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product    Product?   @relation("CreditNoteLineProduct", fields: [productId], references: [id])

  @@index([creditNoteId])
  @@map("credit_note_lines")
}

model DebitNote {
  id          String                @id @default(uuid()) @db.Uuid
  companyId   String                @map("company_id") @db.Uuid
  // Factura origen (misma empresa). Requerida: una ND siempre carga sobre una FE.
  invoiceId   String                @map("invoice_id") @db.Uuid
  number      Int                                        // consecutivo por empresa
  issueDate   DateTime              @map("issue_date")
  reason      String?
  subtotal    Decimal               @default(0) @db.Decimal(15, 2)
  tax         Decimal               @default(0) @db.Decimal(15, 2)
  total       Decimal               @default(0) @db.Decimal(15, 2)
  status      CreditDebitNoteStatus @default(DRAFT)
  createdById String                @map("created_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt      @map("updated_at")

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice         @relation(fields: [invoiceId], references: [id])
  lines   DebitNoteLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([invoiceId])
  @@index([status])
  @@map("debit_notes")
}

model DebitNoteLine {
  id          String   @id @default(uuid()) @db.Uuid
  debitNoteId String   @map("debit_note_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  lineNo      Int      @map("line_no")
  description String
  quantity    Decimal  @db.Decimal(15, 3)
  unit        String   @default("Unid")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15, 2)
  taxRate     Decimal  @map("tax_rate")   @db.Decimal(5, 2)
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(15, 2)
  subtotal    Decimal  @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)
  cabysCode   String?  @map("cabys_code")

  debitNote DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  product   Product?  @relation("DebitNoteLineProduct", fields: [productId], references: [id])

  @@index([debitNoteId])
  @@map("debit_note_lines")
}

// ================================================================
//  BLOQUE 20 — PHASE 19: COTIZACIONES, ORDENES DE COMPRA, AJUSTES
//  DE INVENTARIO
//
//  Tres features independientes, agrupadas en una sola migracion:
//
//    - Quote (cotizacion/presupuesto): propuesta de venta a un cliente
//      ANTES de facturar. NO afecta el Diario ni el inventario. Al
//      convertirse (convert), nace una Invoice real via InvoicesService
//      (misma factura DRAFT que el estudiante emite luego a mano).
//
//    - PurchaseOrder (orden de compra a proveedor externo real): ciclo
//      espejo de las cotizaciones pero del lado de compras. DRAFT ->
//      ISSUED -> RECEIVED (recepcion de mercancia: suma stock + crea
//      lote FIFO, SIN asiento) -> INVOICED (cuando se registra la
//      PurchaseInvoice real que si genera el asiento). Distinto del
//      modulo `procurement` (ProcurementOrder), que es aprovisionamiento
//      ENTRE EMPRESAS del curso -- no se reutiliza ni se toca aca.
//
//    - InventoryAdjustment: merma/conteo fisico/correccion manual de
//      stock. A diferencia de las dos anteriores, SI genera asiento
//      contable (cambia el valor del inventario) via BusinessEventsService
//      (RecordInventoryAdjustmentInput), con trazabilidad sourceType/
//      sourceId (V-5) hacia journal_entries.
// ================================================================

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

// Atomic quote consecutive number per company -- same pattern as InvoiceSequence.
model QuoteSequence {
  companyId  String @id @map("company_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  company Company @relation("QuoteSequenceCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@map("quote_sequences")
}

model Quote {
  id                 String      @id @default(uuid()) @db.Uuid
  companyId          String      @map("company_id") @db.Uuid
  clientId           String      @map("client_id") @db.Uuid
  quoteNumber        Int         @map("quote_number")            // consecutivo por empresa
  issueDate          DateTime    @map("issue_date")
  validUntil         DateTime    @map("valid_until")             // vencimiento de la oferta
  status             QuoteStatus @default(DRAFT)
  currency           String      @default("CRC")
  exchangeRate       Decimal     @default(1) @map("exchange_rate") @db.Decimal(10, 4)
  subtotal           Decimal     @default(0) @db.Decimal(15, 2)
  taxTotal           Decimal     @default(0) @map("tax_total") @db.Decimal(15, 2)
  total              Decimal     @default(0) @db.Decimal(15, 2)
  notes              String?
  // Factura real generada al convertir (SENT/ACCEPTED -> CONVERTED). NULL
  // mientras no se convierte. @unique: una cotizacion se convierte a lo
  // sumo una vez.
  convertedInvoiceId String?     @unique @map("converted_invoice_id") @db.Uuid
  createdById        String      @map("created_by_id") @db.Uuid
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt      @map("updated_at")

  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client           Client      @relation(fields: [clientId], references: [id])
  convertedInvoice Invoice?    @relation("QuoteConvertedInvoice", fields: [convertedInvoiceId], references: [id])
  lines            QuoteLine[]

  @@unique([companyId, quoteNumber])
  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@map("quotes")
}

model QuoteLine {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  lineNo      Int     @map("line_no")
  description String
  quantity    Decimal @db.Decimal(15, 3)
  unit        String  @default("Unid")
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)
  taxRate     Decimal @map("tax_rate")   @db.Decimal(5, 2)
  taxAmount   Decimal @map("tax_amount") @db.Decimal(15, 2)
  subtotal    Decimal @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)
  cabysCode   String? @map("cabys_code")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation("QuoteLineProduct", fields: [productId], references: [id])

  @@index([quoteId])
  @@map("quote_lines")
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  RECEIVED
  CANCELLED
  INVOICED
}

// Atomic purchase-order consecutive number per company.
model PurchaseOrderSequence {
  companyId  String @id @map("company_id") @db.Uuid
  lastNumber Int    @default(0) @map("last_number")

  company Company @relation("PurchaseOrderSequenceCompany", fields: [companyId], references: [id], onDelete: Cascade)

  @@map("purchase_order_sequences")
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  companyId    String              @map("company_id") @db.Uuid
  supplierId   String              @map("supplier_id") @db.Uuid
  orderNumber  Int                 @map("order_number")           // consecutivo por empresa
  issueDate    DateTime            @map("issue_date")
  expectedDate DateTime?           @map("expected_date")
  status       PurchaseOrderStatus @default(DRAFT)
  currency     String              @default("CRC")
  exchangeRate Decimal             @default(1) @map("exchange_rate") @db.Decimal(10, 4)
  subtotal     Decimal             @default(0) @db.Decimal(15, 2)
  taxTotal     Decimal             @default(0) @map("tax_total") @db.Decimal(15, 2)
  total        Decimal             @default(0) @db.Decimal(15, 2)
  notes        String?
  createdById  String              @map("created_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt      @map("updated_at")

  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  lines            PurchaseOrderLine[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  productId       String? @map("product_id") @db.Uuid
  lineNo          Int     @map("line_no")
  description     String
  quantity        Decimal @db.Decimal(15, 3)
  unitCost        Decimal @map("unit_cost") @db.Decimal(15, 2)
  taxRate         Decimal @map("tax_rate")  @db.Decimal(5, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(15, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation("PurchaseOrderLineProduct", fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

enum InventoryAdjustmentType {
  INCREASE
  DECREASE
}

// Historial de ajustes manuales de inventario (merma, conteo fisico, dano,
// correccion al alza). Cada fila queda enlazada al asiento que genero via
// sourceType='inventory_adjustment' / sourceId=this.id (V-5 trazabilidad).
model InventoryAdjustment {
  id          String                   @id @default(uuid()) @db.Uuid
  companyId   String                   @map("company_id") @db.Uuid
  productId   String                   @map("product_id") @db.Uuid
  type        InventoryAdjustmentType
  quantity    Decimal                  @db.Decimal(15, 3)
  unitCost    Decimal                  @map("unit_cost")   @db.Decimal(15, 2)
  totalValue  Decimal                  @map("total_value") @db.Decimal(15, 2)
  reason      String
  // Enlace al asiento generado (journal_entries.source_type/source_id).
  sourceType  String?                  @map("source_type")
  sourceId    String?                  @map("source_id")
  createdById String                   @map("created_by_id") @db.Uuid
  createdAt   DateTime                 @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation("InventoryAdjustmentProduct", fields: [productId], references: [id])

  @@index([companyId])
  @@index([productId])
  @@map("inventory_adjustments")
}
