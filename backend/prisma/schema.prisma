// ================================================================
//  BLOQUE 7 — INVENTARIO
// ================================================================

model ProductCategory {
  id          String    @id @default(uuid()) @db.Uuid
  // Scope multi-tenant (phase16): antes era global y cualquier empresa
  // veía/tocaba las categorías de otras.
  companyId   String    @map("company_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("product_categories")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id")  @db.Uuid
  categoryId   String?  @map("category_id") @db.Uuid
  name         String
  description  String?
  sku          String?
  cabysCode    String?  @map("cabys_code")  // 13 dígitos — obligatorio para facturación CR
  cabysDesc    String?  @map("cabys_desc")  // Descripción desde catálogo CABYS
  price        Decimal  @db.Decimal(15,2)
  cost         Decimal  @default(0) @db.Decimal(15,2)
  taxRate      Decimal  @default(13) @map("tax_rate") @db.Decimal(5,2)
  // Tasas válidas CR: 0, 1, 2, 4, 8, 13
  stock        Decimal  @default(0) @db.Decimal(15,3)
  minStock     Decimal  @default(0) @map("min_stock") @db.Decimal(15,3)
  unit         String   @default("Unid")
  isService    Boolean  @default(false) @map("is_service")
  // Fase 2: si trackInventory=true, las ventas consumen lotes FIFO y registran COGS.
  // Para servicios siempre debería ser false (validado en service layer).
  trackInventory Boolean @default(true) @map("track_inventory")
  isActive     Boolean  @default(true)  @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category     ProductCategory?     @relation(fields: [categoryId], references: [id])
  invoiceItems InvoiceItem[]
  movements    InventoryMovement[]
  lots         InventoryLot[]
  creditNoteLines CreditNoteLine[]  @relation("CreditNoteLineProduct")
  debitNoteLines  DebitNoteLine[]   @relation("DebitNoteLineProduct")
  quoteLines           QuoteLine[]           @relation("QuoteLineProduct")
  purchaseOrderLines   PurchaseOrderLine[]   @relation("PurchaseOrderLineProduct")
  inventoryAdjustments InventoryAdjustment[] @relation("InventoryAdjustmentProduct")

  @@index([companyId])
  @@index([cabysCode])
  @@map("products")
}

model InventoryMovement {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  type          MovementType
  quantity      Decimal      @db.Decimal(15,3)  // negativo = salida
  unitCost      Decimal?     @map("unit_cost") @db.Decimal(15,2)
  // Fase 2: totalCost almacena qty * unitCost para auditoría de COGS sin recalc.
  totalCost     Decimal?     @map("total_cost") @db.Decimal(15,2)
  // Fase 2: lotId apunta al lote consumido (SALE) o creado (PURCHASE/INITIAL).
  lotId         String?      @map("lot_id")     @db.Uuid
  referenceId   String?      @map("reference_id") @db.Uuid  // invoice_id u otro
  referenceType String?      @map("reference_type")
  balanceAfter  Decimal      @map("balance_after") @db.Decimal(15,3)
  notes         String?
  createdById   String       @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")

  product Product       @relation(fields: [productId], references: [id])
  lot     InventoryLot? @relation(fields: [lotId], references: [id])

  @@index([productId])
  @@index([companyId])
  @@index([lotId])
  @@map("inventory_movements")
}

// ── InventoryLot (Fase 2 — FIFO) ────────────────────────────────
//
// Cada compra (o stock inicial) crea un lote con su qty y costo unitario.
// Las ventas consumen lotes ordenados por receivedAt asc (FIFO).
// El índice compuesto [productId, qtyRemaining, receivedAt] está pensado
// para que el query de consumo sea sub-milisegundo aún con miles de lotes:
//   WHERE productId = ? AND qtyRemaining > 0
//   ORDER BY receivedAt ASC
model InventoryLot {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  qtyOriginal  Decimal  @map("qty_original")  @db.Decimal(15,3)
  qtyRemaining Decimal  @map("qty_remaining") @db.Decimal(15,3)
  unitCost     Decimal  @map("unit_cost")     @db.Decimal(15,2)
  source       String   // 'PURCHASE' | 'INITIAL' | 'ADJUSTMENT'
  sourceId     String?  @map("source_id")     // UUID del documento origen (string para no acoplar tipo)
  receivedAt   DateTime @default(now()) @map("received_at")
  createdAt    DateTime @default(now()) @map("created_at")

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([productId, qtyRemaining, receivedAt])
  @@index([companyId])
  @@index([source, sourceId])
  @@map("inventory_lots")
}

// ================================================================
//  BLOQUE 8 — FACTURACIÓN ELECTRÓNICA CR
// ================================================================

model Invoice {
  id                    String        @id @default(uuid()) @db.Uuid
  companyId             String        @map("company_id") @db.Uuid
  clientId              String?       @map("client_id")  @db.Uuid
  clientName            String        @map("client_name")
  clientIdentification  String        @map("client_identification")
  consecutiveNumber     String        @map("consecutive_number")
  clave                 String?
  type                  InvoiceType   @default(FE)
  saleCondition         SaleCondition @default(CASH) @map("sale_condition")
  paymentMethod         PaymentMethod @default(CASH) @map("payment_method")
  currency              String        @default("CRC")
  exchangeRate          Decimal       @default(1)    @map("exchange_rate") @db.Decimal(10,4)
  status                InvoiceStatus @default(DRAFT)
  haciendaStatus        String        @default("PENDING") @map("hacienda_status")
  subtotal              Decimal       @default(0) @db.Decimal(15,2)
  discount              Decimal       @default(0) @db.Decimal(15,2)
  tax                   Decimal       @default(0) @db.Decimal(15,2)
  total                 Decimal       @default(0) @db.Decimal(15,2)
  paidAmount            Decimal       @default(0) @map("paid_amount") @db.Decimal(15,2)
  balanceDue            Decimal       @default(0) @map("balance_due") @db.Decimal(15,2)
  xml                   String?       @db.Text
  pdfUrl                String?       @map("pdf_url")
  // Respaldo del PDF en la BD (mismo patrón que `xml` arriba) — el archivo en
  // disco de Railway se pierde en cada redeploy (contenedor efímero); esto
  // permite regenerarlo en el momento si se perdió (ver getPdfPath()).
  pdfData               Bytes?        @map("pdf_data")
  haciendaResponse      Json?         @map("hacienda_response")
  haciendaMessage       String?       @map("hacienda_message") @db.Text
  notes                 String?
  issueDate             DateTime      @map("issue_date")
  dueDate               DateTime?     @map("due_date")
  creditDays            Int?          @map("credit_days")
  issuedAt              DateTime?     @map("issued_at")
  createdById           String        @map("created_by_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt      @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client              Client?              @relation(fields: [clientId], references: [id])
  createdBy           User                 @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items               InvoiceItem[]
  electronicDocument  ElectronicDocument?
  journalEntries      JournalEntry[]
  invoicePayments     InvoicePayment[]
  arPayments          ArPayment[]
  accountReceivable   AccountReceivable?
  creditNotes         CreditNote[]
  debitNotes          DebitNote[]
  // Phase 19: cotización que dio origen a esta factura (si se creó vía convert).
  quote               Quote?               @relation("QuoteConvertedInvoice")

  @@unique([companyId, consecutiveNumber])
  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([haciendaStatus])
  @@index([createdById])
  @@index([issueDate(sort: Desc)])
  @@index([companyId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  lineNo      Int      @map("line_no")
  description String
  quantity    Decimal  @db.Decimal(15,3)
  unit        String   @default("Unid")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15,2)
  discount    Decimal  @default(0) @db.Decimal(15,2)
  taxRate     Decimal  @map("tax_rate")   @db.Decimal(5,2)
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(15,2)
  subtotal    Decimal  @db.Decimal(15,2)
  total       Decimal  @db.Decimal(15,2)
  cabysCode   String?  @map("cabys_code")  // 13 dígitos

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model ElectronicDocument {
  id           String    @id @default(uuid()) @db.Uuid
  invoiceId    String    @unique @map("invoice_id") @db.Uuid
  clave        String                              // 50 dígitos
  consecutive  String
  xmlContent   String    @map("xml_content") @db.Text
  status       String    @default("PENDING")       // PENDING, ACCEPTED, REJECTED
  haciendaMsg  String?   @map("hacienda_msg") @db.Text
  qrData       String?   @map("qr_data")
  validatedAt  DateTime? @map("validated_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("electronic_documents")
}

// ================================================================
//  BLOQUE 9 — PAGOS Y CUENTAS POR COBRAR
