model PurchaseInvoice {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id")   @db.Uuid
  // Fase 4: opcional para soportar GROUP companies (sin attempt 1:1) y
  // mirror inter-company. INDIVIDUAL siempre lo trae set.
  attemptId      String?  @map("attempt_id")   @db.Uuid
  supplierName   String   @map("supplier_name")
  supplierCedula String?  @map("supplier_cedula")
  invoiceNumber  String   @map("invoice_number")
  date           DateTime
  subtotal       Decimal  @db.Decimal(15, 2)
  taxRate        Decimal  @default(0.13) @map("tax_rate")   @db.Decimal(5, 4)
  taxAmount      Decimal  @db.Decimal(15, 2)               @map("tax_amount")
  total          Decimal  @db.Decimal(15, 2)
  description    String?
  isAccepted     Boolean  @default(true)  @map("is_accepted")
  isPaid         Boolean  @default(false) @map("is_paid")
  paidAmount     Decimal  @default(0)     @map("paid_amount") @db.Decimal(15,2)
  // F2 (Modo Empresarial/ERP): factura del vendedor que originó esta compra
  // inter-company. Permite, al aceptar la propuesta, sincronizar inventario
  // desde las líneas del vendedor. NULL para compras normales del estudiante.
  // @unique: idempotencia del espejo B2B — una factura fuente genera a lo sumo
  // una compra espejo (los NULL son distintos en Postgres, así que las compras
  // normales del estudiante no colisionan). Ver InterCompanyMirror (outbox).
  sourceInvoiceId String? @unique @map("source_invoice_id") @db.Uuid
  // Phase 19: referencia opcional a la orden de compra que originó esta
  // factura (ciclo compras: PO → recepción → factura real del proveedor).
  // NULL para compras registradas sin orden previa (comportamiento histórico).
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attempt        ExerciseAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  purchaseOrder  PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  apPayments     ApPayment[]
  accountPayable AccountPayable?

  @@index([companyId])
  @@index([attemptId])
  @@index([purchaseOrderId])
  @@map("purchase_invoices")
}

// ── F2.3 · Modo ERP Completo — orden de aprovisionamiento (state machine) ──
// Flujo entre empresas del mismo curso: PO_ISSUED → DISPATCHED → RECEIVED
// (inventario en B) → INVOICED (Invoice del vendedor + PurchaseInvoice + asiento
// + CxP en B) → PAID (pago). buyer/seller como UUID scalars (sin relación) para
// no tocar la lista de relaciones de Company.
model ProcurementOrder {
  id                String   @id @default(uuid()) @db.Uuid
  // Contexto: un ejercicio (empresas del curso) O un grupo de práctica
  // (multiempresa en modo Contador). Exactamente uno de los dos.
  exerciseId        String?  @map("exercise_id") @db.Uuid
  practiceGroupId   String?  @map("practice_group_id") @db.Uuid
  buyerCompanyId    String   @map("buyer_company_id") @db.Uuid
  sellerCompanyId   String   @map("seller_company_id") @db.Uuid
  status            String   @default("PO_ISSUED")  // PO_ISSUED|DISPATCHED|RECEIVED|INVOICED|PAID|CANCELLED
  items             Json     // [{ description, cabysCode, quantity, unitPrice }]
  subtotal          Decimal  @db.Decimal(15, 2)
  taxAmount         Decimal  @db.Decimal(15, 2) @map("tax_amount")
  total             Decimal  @db.Decimal(15, 2)
  sellerInvoiceId   String?  @map("seller_invoice_id")   @db.Uuid
  purchaseInvoiceId String?  @map("purchase_invoice_id") @db.Uuid
  notes             String?
  createdById       String   @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  @@index([exerciseId])
  @@index([practiceGroupId])
  @@index([buyerCompanyId])
  @@index([sellerCompanyId])
  @@map("procurement_orders")
}

// ── Outbox del espejo inter-company (transactional outbox) ──
// Estado durable del reflejo venta→compra. La venta del vendedor SIEMPRE
// persiste (una factura electrónica válida no depende de que la contraparte
// registre su compra); acá se registra si el espejo se aplicó, quedó pendiente,
// falló (reintentable) o no aplica (cliente externo al universo). Esto
// desambigua "falla de plataforma" de "omisión del estudiante": el oráculo de
// auditoría solo cruza facturas con status DONE, nunca PENDING/FAILED.
// seller/buyer/source/purchase como UUID scalars sin relación, mismo criterio
// que ProcurementOrder (no inflar la lista de relaciones de Company/Invoice).
enum MirrorStatus {
  NOT_APPLICABLE  // cliente externo, feature apagado o sin contraparte — sin obligación
  PENDING         // obligación creada, espejo aún no aplicado
  DONE            // compra espejo (o propuesta) registrada en el comprador
  FAILED          // falla de plataforma (periodo cerrado, plan incompleto...) — reintentable
}

model InterCompanyMirror {
  id                String       @id @default(uuid()) @db.Uuid
  sourceInvoiceId   String       @unique @map("source_invoice_id") @db.Uuid  // idempotencia: un espejo por factura fuente
  sellerCompanyId   String       @map("seller_company_id") @db.Uuid
  buyerCompanyId    String?      @map("buyer_company_id")  @db.Uuid          // NULL hasta resolver el match por cédula
  status            MirrorStatus @default(PENDING)
  reason            String?      // código legible: no_matching_company, buyer_no_open_period, ...
  attempts          Int          @default(0)
  lastError         String?      @map("last_error")
  lastAttemptAt     DateTime?    @map("last_attempt_at")
  purchaseInvoiceId String?      @map("purchase_invoice_id") @db.Uuid        // la compra generada en B cuando DONE
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt      @map("updated_at")

  @@index([sellerCompanyId])
  @@index([buyerCompanyId])
  @@index([status])
  @@map("inter_company_mirrors")
}

// ── Multiempresa en modo práctica (Espacio Contador) — grupos de estudiantes ──
// Los estudiantes forman un grupo; sus empresas de PRÁCTICA (isPractice) se unen
// y pueden comerciar entre sí (misma máquina de estados de ProcurementOrder,
// usando practiceGroupId en vez de exerciseId).
model PracticeGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique              // código de invitación para unirse
